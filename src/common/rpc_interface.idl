[
    uuid(12345678-1234-1234-1234-123456789ABC),
    version(1.0),
    pointer_default(unique)
]
interface ServiceControl
{
    void StopService([in] handle_t hBinding);
    long GetStatus([in] handle_t hBinding);
    void Shutdown([in] handle_t hBinding);
    long GetUserInfo([in] handle_t hBinding, [out, string] wchar_t** username);
    long Login([in] handle_t hBinding, [in, string] const wchar_t* username, [in, string] const wchar_t* password);
    long Logout(
        [in] handle_t IDL_handle
    );
    long GetLicenseInfo([in] handle_t hBinding, [out] long* daysRemaining, [out, string] wchar_t** expiryDate);
    long ActivateProduct([in] handle_t hBinding, [in, string] const wchar_t* activationKey);
}