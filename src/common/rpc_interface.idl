[
    uuid(12345678-1234-1234-1234-123456789ABC),
    version(1.0),
    implicit_handle(handle_t hServiceBinding)
]
interface ServiceControl
{
    // Остановка службы
    void StopService();

    // Проверка состояния службы
    int CheckServiceStatus();

    // Завершение работы
    void Shutdown();
}